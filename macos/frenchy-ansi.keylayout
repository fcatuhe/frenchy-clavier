            <when state="dead_acute" output="ź"/>
        </action>
        <action id="Agrave">
            <when state="none" output="À"/>
            <when state="dead_circumflex" output="Ầ"/>
        </action>
        <action id="AE">
            <when state="none" output="Æ"/>
            <when state="dead_acute" output="Ǽ"/>
        </action>
        <action id="Ccedilla">
            <when state="none" output="Ç"/>
            <when state="dead_acute" output="Ḉ"/>
        </action>
        <action id="Egrave">
            <when state="none" output="È"/>
            <when state="dead_circumflex" output="Ề"/>
        </action>
        <action id="Eacute">
            <when state="none" output="É"/>
            <when state="dead_circumflex" output="Ế"/>
        </action>
        <action id="Ugrave">
            <when state="none" output="Ù"/>
            <when state="dead_diaeresis" output="Ǜ"/>
        </action>
        <action id="agrave">
            <when state="none" output="à"/>
            <when state="dead_circumflex" output="ầ"/>
        </action>
        <action id="ae">
            <when state="none" output="æ"/>
            <when state="dead_acute" output="ǽ"/>
        </action>
        <action id="ccedilla">
            <when state="none" output="ç"/>
            <when state="dead_acute" output="ḉ"/>
        </action>
        <action id="egrave">
            <when state="none" output="è"/>
            <when state="dead_circumflex" output="ề"/>
        </action>
        <action id="eacute">
            <when state="none" output="é"/>
            <when state="dead_circumflex" output="ế"/>
        </action>
        <action id="ugrave">
            <when state="none" output="ù"/>
            <when state="dead_diaeresis" output="ǜ"/>
        </action>
    </actions>
    <terminators>
        <when state="dead_tilde" output="~"/>
        <when state="dead_diaeresis" output="&quot;"/>
        <when state="dead_circumflex" output="^"/>
        <when state="dead_grave" output="`"/>
        <when state="dead_acute" output="'"/>
    </terminators>
</keyboard>
