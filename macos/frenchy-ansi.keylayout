        </action>
        <action id="9">
            <when state="none" output="9"/>
            <when state="dead_circumflex" output="⁹"/>
        </action>
        <action id="less">
            <when state="none" output="&lt;"/>
            <when state="dead_tilde" output="≲"/>
        </action>
        <action id="equal">
            <when state="none" output="="/>
            <when state="dead_tilde" output="≃"/>
            <when state="dead_circumflex" output="⁼"/>
        </action>
        <action id="greater">
            <when state="none" output="&gt;"/>
            <when state="dead_tilde" output="≳"/>
        </action>
        <action id="A">
            <when state="none" output="A"/>
            <when state="dead_tilde" output="Ã"/>
            <when state="dead_diaeresis" output="Ä"/>
            <when state="dead_circumflex" output="Â"/>
            <when state="dead_grave" output="À"/>
            <when state="dead_acute" output="Á"/>
        </action>
        <action id="C">
