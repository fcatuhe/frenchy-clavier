    <actions>
        <action id="dead_tilde">
            <when state="none" next="dead_tilde"/>
        </action>
        <action id="dead_diaeresis">
            <when state="none" next="dead_diaeresis"/>
        </action>
        <action id="dead_circumflex">
            <when state="none" next="dead_circumflex"/>
        </action>
        <action id="dead_grave">
            <when state="none" next="dead_grave"/>
        </action>
        <action id="dead_acute">
            <when state="none" next="dead_acute"/>
        </action>
        <action id="apostrophe">
            <when state="none" output="'"/>
            <when state="dead_diaeresis" output="̈́"/>
        </action>
        <action id="parenleft">
            <when state="none" output="("/>
            <when state="dead_circumflex" output="⁽"/>
        </action>
        <action id="parenright">
            <when state="none" output=")"/>
            <when state="dead_circumflex" output="⁾"/>
        </action>
        <action id="plus">
            <when state="none" output="+"/>
            <when state="dead_circumflex" output="⁺"/>
        </action>
        <action id="minus">
            <when state="none" output="-"/>
            <when state="dead_circumflex" output="⁻"/>
        </action>
        <action id="period">
            <when state="none" output="."/>
            <when state="dead_circumflex" output="·"/>
        </action>
        <action id="0">
            <when state="none" output="0"/>
            <when state="dead_circumflex" output="⁰"/>
        </action>
        <action id="1">
            <when state="none" output="1"/>
            <when state="dead_circumflex" output="¹"/>
        </action>
        <action id="2">
