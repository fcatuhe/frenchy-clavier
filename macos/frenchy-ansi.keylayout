            <when state="dead_diaeresis" output="ü"/>
            <when state="dead_circumflex" output="û"/>
            <when state="dead_grave" output="ù"/>
            <when state="dead_acute" output="ú"/>
        </action>
        <action id="v">
            <when state="none" output="v"/>
            <when state="dead_tilde" output="ṽ"/>
            <when state="dead_grave" output="ǜ"/>
            <when state="dead_acute" output="ǘ"/>
        </action>
        <action id="w">
            <when state="none" output="w"/>
