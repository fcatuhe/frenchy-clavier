        </action>
        <action id="y">
            <when state="none" output="y"/>
            <when state="dead_tilde" output="ỹ"/>
            <when state="dead_diaeresis" output="ÿ"/>
            <when state="dead_circumflex" output="ŷ"/>
            <when state="dead_grave" output="ỳ"/>
            <when state="dead_acute" output="ý"/>
        </action>
        <action id="z">
