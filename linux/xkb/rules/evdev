! include %S/evdev

! layout = types
  frenchy = +frenchy(leddigits)

! layout[1] = types
  frenchy = +frenchy(leddigits)

! layout[2] = types
  frenchy = +frenchy(leddigits)

! layout[3] = types
  frenchy = +frenchy(leddigits)

! layout[4] = types
  frenchy = +frenchy(leddigits)

! layout = compat
  frenchy = +frenchy(leddigits)

! layout[1] = compat
  frenchy = +frenchy(leddigits)

! layout[2] = compat
  frenchy = +frenchy(leddigits)

! layout[3] = compat
  frenchy = +frenchy(leddigits)

! layout[4] = compat
  frenchy = +frenchy(leddigits)

! layout option = symbols
  *       frenchy:capslock = +frenchy(shiftlock)
  *       frenchy:capslock = +compose(caps)
  frenchy frenchy:capslock = +frenchy(digitlock)

! layout[1] option = symbols
  *       frenchy:capslock = +frenchy(shiftlock):1
  *       frenchy:capslock = +compose(caps):1
  frenchy frenchy:capslock = +frenchy(digitlock):1

! layout[2] option = symbols
  *       frenchy:capslock = +frenchy(shiftlock):2
  *       frenchy:capslock = +compose(caps):2
  frenchy frenchy:capslock = +frenchy(digitlock):2

! layout[3] option = symbols
  *       frenchy:capslock = +frenchy(shiftlock):3
  *       frenchy:capslock = +compose(caps):3
  frenchy frenchy:capslock = +frenchy(digitlock):3

! layout[4] option = symbols
  *       frenchy:capslock = +frenchy(shiftlock):4
  *       frenchy:capslock = +compose(caps):4
  frenchy frenchy:capslock = +frenchy(digitlock):4
