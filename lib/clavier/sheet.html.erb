<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title><%= escape(layout.title) %></title>
<style>
  :root {
    --paper: #f7f4ee;
    --ink: #17130f;
    --ink-soft: #8b8177;
    --altgr: #b4541b;
    --dead: #2f6f6a;
    --edge: #cfc7ba;
    --edge-strong: #9a9186;
    --key: 76px;
    --gap: 5px;
    --radius: 7px;
    --step: 6px;
    --mono: ui-monospace, "JetBrains Mono", "DejaVu Sans Mono", monospace;
    --sans: ui-sans-serif, "Inter", "DejaVu Sans", system-ui, sans-serif;
  }

  * { box-sizing: border-box; }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    margin: 0;
    padding: calc(var(--step) * 5);
  }

  header { margin-bottom: calc(var(--step) * 4); }

  h1 { font-size: 1.4rem; letter-spacing: -0.01em; margin: 0; }

  .subtitle { color: var(--ink-soft); font-size: 0.85rem; margin-top: var(--step); }

  .board { display: flex; flex-direction: column; gap: var(--gap); width: max-content; }

  .row { display: flex; gap: var(--gap); }

  .slot {
    width: calc(var(--span) * var(--key) + (var(--span) - 1) * var(--gap));
    height: var(--key);
    border: 1px solid var(--edge-strong);
    border-radius: var(--radius);
    box-shadow: 0 1px 0 var(--edge);
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    padding: 3px 5px;
  }

  .slot.fixed, .slot.fn {
    align-content: center;
    justify-content: center;
    color: var(--ink-soft);
    display: flex;
    font-size: 0.7rem;
  }

  .slot.fn { height: calc(var(--key) * 0.62); }

  .slot.stack {
    display: flex;
    flex-direction: column;
    color: var(--ink-soft);
    font-size: 0.6rem;
    align-items: center;
    justify-content: space-around;
  }

  .q { font-family: var(--mono); font-size: 1.15rem; line-height: 1; }

  .q.shift { grid-area: 1 / 1; }
  .q.base { grid-area: 2 / 1; align-self: end; }
  .q.altgr-shift { grid-area: 1 / 2; justify-self: end; }
  .q.altgr { grid-area: 2 / 2; justify-self: end; align-self: end; }

  .q.altgr, .q.altgr-shift { color: var(--altgr); font-size: 0.95rem; }

  .q.dead { color: var(--dead); }
  .q.dead::after { content: "\25CC"; font-size: 0.7em; vertical-align: super; }

  .q.word { font-size: 0.55rem; letter-spacing: 0.02em; }

  footer { margin-top: calc(var(--step) * 5); max-width: calc(15 * var(--key)); }

  .legend { display: flex; flex-wrap: wrap; gap: calc(var(--step) * 3); font-size: 0.75rem; color: var(--ink-soft); }

  .legend b { color: var(--ink); font-weight: 600; }

  .legend .swatch-altgr { color: var(--altgr); }
  .legend .swatch-dead { color: var(--dead); }

  h2 { font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); margin: calc(var(--step) * 4) 0 var(--step); }

  .free { font-family: var(--mono); font-size: 0.65rem; color: var(--ink-soft); columns: 5; }

  .free li { list-style: none; }
  .free ul { margin: 0; padding: 0; }

  @page { size: A4 landscape; margin: 10mm; }

  @media print {
    :root { --key: 17mm; --gap: 1mm; }
    body { padding: 0; background: #fff; }
  }

  <%= unit_classes %>
</style>
</head>
<body>
<header>
  <h1><%= escape(layout.title) %></h1>
  <p class="subtitle"><%= escape(layout.subtitle) %> &middot; base + Shift + AltGr + AltGr&#8202;Shift</p>
</header>

<div class="board">
<% rows.each_with_index do |row, row_index| -%>
  <div class="row">
  <% row.each do |slot| -%>
    <% if slot.stack -%>
    <div class="slot stack <%= unit_class(slot.width) %>"><span><%= escape(slot.stack[0]) %></span><span><%= escape(slot.stack[1]) %></span></div>
    <% elsif slot.code.nil? -%>
    <div class="slot <%= row_index.zero? ? "fn" : "fixed" %> <%= unit_class(slot.width) %>"><%= escape(slot.label) %></div>
    <% else -%>
    <%
      key = layout[slot.code]
      quadrants = [["base", 0], ["shift", 1], ["altgr", 2], ["altgr-shift", 3]]
    -%>
    <div class="slot <%= unit_class(slot.width) %>">
      <% quadrants.each do |name, index| -%>
      <% glyph = key.glyph(index) -%>
      <% next if glyph.empty? -%>
      <span class="q <%= name %><%= " dead" if key.dead?(index) %><%= " word" if glyph.size > 1 %>"><%= escape(glyph) %></span>
      <% end -%>
    </div>
    <% end -%>
  <% end -%>
  </div>
<% end -%>
</div>

<footer>
  <div class="legend">
    <span><b>bottom left</b> base</span>
    <span><b>top left</b> Shift</span>
    <span class="swatch-altgr"><b>bottom right</b> AltGr</span>
    <span class="swatch-altgr"><b>top right</b> AltGr + Shift</span>
    <span class="swatch-dead"><b>&#9676;</b> dead key</span>
    <span>Ctrl and Fn are drawn swapped (BIOS)</span>
  </div>

  <h2>Free levels (<%= layout.free_levels.size %>)</h2>
  <div class="free">
    <ul>
    <% layout.free_levels.each do |slot| -%>
      <li><%= escape(slot) %></li>
    <% end -%>
    </ul>
  </div>
</footer>
</body>
</html>
