<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title><%= escape(layout.title) %></title>
<style>
  :root {
    --paper: #f7f4ee;
    --ink: #17130f;
    --ink-soft: #8b8177;
    --altgr: #b4541b;
    --dead: #2f6f6a;
    --edge: #cfc7ba;
    --edge-strong: #9a9186;
    --units: <%= format('%.4f', board.units) %>;
    --pitch: 80px;
    --gap: 5px;
    --radius: 7px;
    --step: 6px;
    --mono: ui-monospace, "JetBrains Mono", "DejaVu Sans Mono", monospace;
    --sans: ui-sans-serif, "Inter", "DejaVu Sans", system-ui, sans-serif;
  }

  * { box-sizing: border-box; }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    margin: 0;
    padding: calc(var(--step) * 5);
  }

  header { margin-bottom: calc(var(--step) * 4); }

  h1 { font-size: 1.4rem; letter-spacing: -0.01em; margin: 0; }

  .subtitle { color: var(--ink-soft); font-size: 0.85rem; margin-top: var(--step); }

  .board {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    width: calc(var(--units) * var(--pitch) - var(--gap));
  }

  .row { display: flex; gap: var(--gap); }

  .row-fn { --gap: calc(var(--pitch) / 40); margin-bottom: calc(var(--pitch) / 20); }

  .slot {
    width: calc((100% - (var(--slots) - 1) * var(--gap)) * var(--span) / var(--units));
    flex: none;
    height: calc(var(--pitch) - var(--gap));
    border: 1px solid var(--edge-strong);
    border-radius: var(--radius);
    box-shadow: 0 1px 0 var(--edge);
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    padding: 7px 6px 3px;
  }

  .row-fn .slot { height: calc((var(--pitch) - var(--gap)) * 0.667); }

  .slot.join-below { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }

  .slot.join-above {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-top: none;
    height: var(--pitch);
    margin-top: calc(-1 * var(--gap));
  }

  .slot.fixed {
    align-content: center;
    justify-content: center;
    color: var(--ink-soft);
    display: flex;
    font-size: 0.72rem;
  }

  .slot.spacer { border: none; box-shadow: none; padding: 0; }

  .slot.cluster {
    border: none;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    padding: 0;
  }

  .cluster-row { display: flex; gap: var(--gap); flex: 1; }

  .mini {
    flex: 1;
    border: 1px solid var(--edge-strong);
    border-radius: var(--radius);
    box-shadow: 0 1px 0 var(--edge);
    color: var(--ink-soft);
    font-size: 0.62rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .q { font-family: var(--mono); font-size: 1.15rem; line-height: 1; }

  .q.dead { line-height: 1.1; }

  .q.shift { grid-area: 1 / 1; }
  .q.base { grid-area: 2 / 1; align-self: end; }
  .q.altgr-shift { grid-area: 1 / 2; justify-self: end; }
  .q.altgr { grid-area: 2 / 2; justify-self: end; align-self: end; }

  .q.altgr, .q.altgr-shift { color: var(--altgr); font-size: 0.95rem; }

  .q.dead { color: var(--dead); }

  .q.word { font-size: 0.55rem; letter-spacing: 0.02em; }

  .compose .slot { background: none; }

  .compose .q { color: var(--dead); }

  .compose .q.altgr, .compose .q.altgr-shift { color: var(--altgr); }

  .seq { border-collapse: collapse; font-size: 0.78rem; margin-top: var(--step); }

  .seq td, .seq th { padding: 2px 18px 2px 0; text-align: left; }

  .seq th { font-weight: 400; font-size: 0.7rem; color: var(--ink-soft); }

  .seq .keys { font-family: var(--mono); color: var(--ink-soft); }

  .seq .out { font-family: var(--mono); font-size: 1rem; }

  footer { margin-top: calc(var(--step) * 5); max-width: calc(var(--units) * var(--pitch)); }

  .legend { display: flex; flex-wrap: wrap; gap: calc(var(--step) * 3); font-size: 0.75rem; color: var(--ink-soft); }

  .legend b { color: var(--ink); font-weight: 600; }

  .legend .swatch-altgr { color: var(--altgr); }
  .legend .swatch-dead { color: var(--dead); }

  h2 { font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); margin: calc(var(--step) * 4) 0 var(--step); }

  .free { font-family: var(--mono); font-size: 0.65rem; color: var(--ink-soft); columns: 5; }

  .free li { list-style: none; }
  .free ul { margin: 0; padding: 0; }

  @page { size: A4 landscape; margin: 10mm; }

  @media print {
    :root { --pitch: 18mm; --gap: 1mm; }
    body { padding: 0; background: #fff; }
  }

  <%= unit_classes %>

  <%= slot_count_classes %>
</style>
</head>
<body>
<header>
  <h1><%= escape(layout.title) %></h1>
  <p class="subtitle"><%= escape(board.name) %> &middot; <%= board.iso? ? "ISO" : "ANSI" %> &middot; direct + Maj + AltGr + AltGr&#8202;Maj</p>
</header>

<div class="board">
<% rows.each_with_index do |row, row_index| -%>
  <div class="row n<%= row.size %><%= " row-fn" if row_index.zero? %>">
  <% row.each do |slot| -%>
    <% if slot.spacer -%>
    <div class="slot spacer <%= unit_class(slot.width) %>"></div>
    <% elsif slot.cluster -%>
    <div class="slot cluster <%= unit_class(slot.width) %>">
      <% slot.cluster.each do |cluster_row| -%>
      <div class="cluster-row"><% cluster_row.each do |label| %><span class="mini"><%= escape(label.to_s) %></span><% end %></div>
      <% end -%>
    </div>
    <% elsif slot.code.nil? -%>
    <div class="slot fixed <%= unit_class(slot.width) %><%= " join-#{slot.join}" if slot.join %>"><%= escape(slot.label.to_s) %></div>
    <% else -%>
    <%
      key = key(slot.code)
      quadrants = [["base", 0], ["shift", 1], ["altgr", 2], ["altgr-shift", 3]]
    -%>
    <div class="slot <%= unit_class(slot.width) %>">
      <% quadrants.each do |name, index| -%>
      <% glyph = key.glyph(index) -%>
      <% next if glyph.empty? -%>
      <span class="q <%= name %><%= " dead" if key.dead?(index) %><%= " word" if glyph.scan(/\X/).size > 1 %>"><%= escape(glyph) %></span>
      <% end -%>
    </div>
    <% end -%>
  <% end -%>
  </div>
<% end -%>
</div>

<% if compose -%>
<h2>Compose (Verr. maj.), puis la même touche deux fois</h2>

<div class="board compose">
<% rows.each_with_index do |row, row_index| -%>
  <div class="row n<%= row.size %><%= " row-fn" if row_index.zero? %>">
  <% row.each do |slot| -%>
    <% if slot.code.nil? -%>
    <div class="slot spacer <%= unit_class(slot.width) %>"></div>
    <% else -%>
    <div class="slot <%= unit_class(slot.width) %>">
      <% [["base", 0], ["shift", 1], ["altgr", 2], ["altgr-shift", 3]].each do |name, index| -%>
      <% glyph = composed(slot.code, index) -%>
      <% next unless glyph -%>
      <% next unless glyph -%>
      <span class="q <%= name %>"><%= escape(glyph) %></span>
      <% end -%>
    </div>
    <% end -%>
  <% end -%>
  </div>
<% end -%>
</div>

<h2>Les suites Compose qui servent</h2>
<table class="seq">
  <tr><th class="out"></th><th class="keys">après Compose</th><th class="keys">sur cette disposition</th></tr>
  <% compose_table.each do |sequence, physical, output| -%>
  <tr><td class="out"><%= escape(output) %></td><td class="keys"><%= escape(sequence) %></td><td class="keys"><%= escape(physical) %></td></tr>
  <% end -%>
</table>
<% end -%>

<footer>
  <div class="legend">
    <span><b>en bas à gauche</b> direct</span>
    <span><b>en haut à gauche</b> Maj</span>
    <span class="swatch-altgr"><b>en bas à droite</b> AltGr</span>
    <span class="swatch-altgr"><b>en haut à droite</b> AltGr + Maj</span>
    <span class="swatch-dead"><b>&#9676;&#769;</b> touche morte</span>
  </div>

  <h2>Niveaux libres (<%= layout.free_levels.size %>)</h2>
  <div class="free">
    <ul>
    <% layout.free_levels.each do |slot| -%>
      <li><%= escape(slot) %></li>
    <% end -%>
    </ul>
  </div>
</footer>
</body>
</html>
