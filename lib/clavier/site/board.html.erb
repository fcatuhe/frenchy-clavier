<div class="board <%= board_class(@board) %>" data-board="<%= @board.id %>">
<% @board.rows.each_with_index do |row, index| -%>
  <div class="row n<%= row.size %><%= " row-fn" if index.zero? %>">
  <% row.each do |slot| -%>
    <% classes = [unit_class(slot.width), ("join-#{slot.join}" if slot.join)].compact.join(" ") -%>
    <% if slot.spacer -%>
    <div class="slot spacer <%= classes %>"></div>
    <% elsif slot.cluster -%>
    <div class="slot cluster <%= classes %>">
      <% slot.cluster.each do |cluster_row| -%>
      <div class="cluster-row"><% cluster_row.each do |label| %><span class="mini"><%= escape(label.to_s) %></span><% end %></div>
      <% end -%>
    </div>
    <% elsif slot.code.nil? -%>
    <div class="slot fixed <%= classes %>"><%= escape(slot.label.to_s) %></div>
    <% else -%>
    <% entry = key(@board, slot.code) -%>
    <div class="slot <%= classes %>"<%= %( data-code="#{WebCodes[slot.code]}") if WebCodes[slot.code] %>>
      <% quadrants.each do |name, level| -%>
      <% glyph = entry.glyph(level) -%>
      <% next if glyph.empty? -%>
      <span class="q <%= name %><%= " dead" if entry.dead?(level) %><%= " word" if glyph.scan(/\X/).size > 1 %>"><%= escape(glyph) %></span>
      <% end -%>
    </div>
    <% end -%>
  <% end -%>
  </div>
<% end -%>
</div>
