#!/usr/bin/env ruby
require "fileutils"
require_relative "../lib/clavier"

root = File.expand_path("..", __dir__)
layout = Clavier::Layout.load(File.join(root, "layout.yml"))
xkb = Clavier::Xkb.new(layout)

written = { "symbols/#{layout.name}" => xkb.symbols,
            "compat/#{layout.name}" => xkb.compat,
            "rules/evdev.xml" => xkb.registry,
            "rules/evdev" => xkb.rules }

written.each do |path, content|
  target = File.join(root, "linux", "xkb", path)
  FileUtils.mkdir_p(File.dirname(target))
  File.write(target, content)
  puts target
end

printed = Clavier::Sheet.new(layout, compose_path: File.join(root, "compose.yml")).to_s

SHEETS = [ %w[out sheet.html], %w[site public sheet.html] ].freeze

SHEETS.each do |parts|
  sheet = File.join(root, *parts)
  FileUtils.mkdir_p(File.dirname(sheet))
  File.write(sheet, printed)
  puts sheet
end
