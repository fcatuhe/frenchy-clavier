#!/usr/bin/env ruby
require "json"
require_relative "../lib/clavier"

root = File.expand_path("..", __dir__)
layout = Clavier::Layout.load(File.join(root, "layout.yml"))

system(File.join(root, "bin", "build"), out: File::NULL) or abort("build failed")
system(File.join(root, "linux", "install.sh")) or abort("install failed, nothing applied")

FCITX_RESTART = "omarchy-restart-xcompose"

def on_path?(command) = ENV.fetch("PATH").split(File::PATH_SEPARATOR).any? { File.executable?(File.join(it, command)) }

exit unless on_path?("hyprctl")

options = IO.popen(%w[hyprctl getoption input:kb_options], err: File::NULL, &:read)[/^str: (.*)$/, 1]
exit if options.nil?
abort("kb_options #{options.inspect} is not a plain option list, recompile by hand") unless options.match?(/\A[\w:,.-]*\z/)

# INFO: fc 24oct26 Hyprland recompiles the keymap only when an input value changes, so we change one and put it back
[options.empty? ? "grp:ctrls_toggle" : "", options].each do |value|
  system("hyprctl", "eval", "hl.config({ input = { kb_options = #{value.dump} } })", out: File::NULL) or
    abort("hyprctl eval failed, Hyprland may still run kb_options = #{value.dump}: run hyprctl reload")
end

# INFO: fc 26sep26 fcitx5 forwards every key through a virtual keyboard holding the keymap it started with
if on_path?(FCITX_RESTART)
  system(FCITX_RESTART) or abort("#{FCITX_RESTART} failed, fcitx5 still types the old keymap")
end

devices = JSON.parse(IO.popen(%w[hyprctl devices -j], err: File::NULL, &:read))
running = devices.fetch("keyboards", []).filter_map { it["active_keymap"] }.uniq
exit if running.any? { it.start_with?(layout.title) }

warn <<~ELSEWHERE
  Hyprland recompiled, but runs #{running.join(', ')}: ~/.config/hypr/input.lua does not
  select #{layout.name}. The Linux section of the README has the block to add.
ELSEWHERE
