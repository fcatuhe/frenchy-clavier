<section class="tester" data-controller="tester">
  <h2>Essayez, rien à installer</h2>
  <p>
    Tapez ici : la page lit vos touches par leur position et leur applique frenchy-clavier.
    La touche pressée s'allume sur le clavier ci-dessus.
  </p>

  <%= tag.textarea "", rows: 3, spellcheck: false, "aria-label": "Essayer la disposition",
        placeholder: "Essayez à é è, AltGr+c, AltGr+u, ^ puis e, ou Verr. maj. puis o o.",
        data: { tester_target: "box", action: "keydown->tester#press blur->tester#reset" } %>

  <%= tag.script Keyboard.keymap.to_json.html_safe, type: "application/json",
        data: { tester_target: "keymap" } %>
</section>
