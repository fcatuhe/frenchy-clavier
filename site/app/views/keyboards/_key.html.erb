<div class="slot <%= key_classes(slot, key, diff) %>" data-code="<%= Clavier::WebCodes[slot.code] %>">
  <% quadrants.each do |name, level| -%>
    <% glyph = key.glyph(level) -%>
    <% next if glyph.empty? -%>
  <span class="q <%= name %><%= " dead" if key.dead?(level) %><%= " word" if glyph.scan(/\X/).size > 1 %>"><%= glyph %></span>
  <% end -%>
</div>
