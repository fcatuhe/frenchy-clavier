<div class="controls">
  <fieldset class="switch">
    <legend>Clavier</legend>
    <div class="options">
      <% boards.each_with_index do |board, index| %>
        <%= tag.input type: "radio", name: "board", id: "board-#{board.id}", checked: index.zero? %>
        <%= label_tag "board-#{board.id}", board_shape(board) %>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="switch">
    <legend>Affichage</legend>
    <div class="options">
      <%= tag.input type: "checkbox", id: "diff", checked: true %>
      <%= label_tag "diff", "Griser ce qui ne change pas" %>
    </div>
  </fieldset>
</div>

<figure class="stage">
  <%= render partial: "keyboards/board", collection: boards, as: :board %>
</figure>

<p class="legend">
  <span><b class="altgr">é</b> AltGr</span>
  <span><b class="dead">&#9676;&#769;</b> touche morte</span>
  <span class="diff"><b class="same">a</b> comme sur l'AZERTY</span>
</p>
